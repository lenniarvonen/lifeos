# Optional JSON objects mapping a Telegram channel id (from TELEGRAM_CHANNELS)
# or a Gmail account key ("gmail"/"gmail_founders") to a display name / a
# single-character page icon (e.g. an emoji) shown in Notion. Left empty,
# entries just fall back to the raw channel id and no icon. Example:
# CHANNEL_DISPLAY_NAMES={"somechannel": "Some Channel", "gmail_founders": "Work Gmail"}
# CHANNEL_ICONS={"somechannel": "<icon character>", "gmail_founders": "<icon character>"}
CHANNEL_DISPLAY_NAMES=
CHANNEL_ICONS=
